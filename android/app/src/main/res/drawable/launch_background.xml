<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown for the fraction of a second before Flutter draws its first frame.
  The stock template uses white here, which reads as a flash on a dark theme;
  matching the icon background makes launch look continuous instead.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
