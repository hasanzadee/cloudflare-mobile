<?xml version="1.0" encoding="utf-8"?>
<!--
  Base variant. minSdk is 26, so drawable-v21 is the one that actually loads;
  this exists because the resource still has to resolve without a qualifier.
  Keep the two in step — see the v21 copy for why <bitmap> is not used.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center"
        android:width="160dp"
        android:height="160dp" />
</layer-list>
