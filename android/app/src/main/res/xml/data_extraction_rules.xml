<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device through cloud backup or a
  device-to-device transfer. The encrypted credential blobs would otherwise be
  swept into Google's backup along with the rest of shared_prefs.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
